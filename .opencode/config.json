{
    "version": "1.0",
    "project": {
        "sandbox": {
            "enabled": true,
            "restrict_to_project_root": true
        }
    },
    "security": {
        "bash": {
            "deny": [
                "git add*",
                "git commit*",
                "git push*",
                "git checkout*",
                "git merge*",
                "git rebase*",
                "git branch*",
                "git remote*",
                "git clone*",
                "git init*"
            ],
            "allow": [
                "git status",
                "git diff*",
                "git log*",
                "npm *",
                "npx *",
                "vitest *",
                "ls *",
                "find *",
                "cat *"
            ]
        },
        "fs": {
            "allow_read": [
                "./**"
            ],
            "deny_read": [
                "../**",
                "~/**",
                "/etc/**",
                "/var/**"
            ]
        }
    }
}
